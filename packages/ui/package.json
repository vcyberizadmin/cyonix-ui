{
  "name": "@vcyberizadmin/ui",
  "version": "1.0.1",
  "description": "Shared React component library for the Cyonix apps",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./overlays": {
      "types": "./dist/overlays/index.d.ts",
      "import": "./dist/overlays/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js"
    },
    "./lib/status": {
      "types": "./dist/lib/status.d.ts",
      "import": "./dist/lib/status.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/preserve-directives.mjs",
    "dev": "tsup --watch --no-clean",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-utilities.mjs",
    "test": "pnpm build && pnpm typecheck && pnpm verify && pnpm verify:merge && pnpm verify:dates && pnpm test:unit",
    "verify:merge": "node scripts/verify-merge.mjs",
    "verify:dates": "node scripts/verify-dates.mjs",
    "test:unit": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vcyberizadmin/theme": "workspace:*",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
